# TasteBud Backend configuration
# Copy to .env and fill secrets

# Database
TASTEBUD_DATABASE_URL=sqlite:///./tastebud.db

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# Server
HOST=0.0.0.0
PORT=8010
DEBUG=true

# CORS
# Comma-separated list of exact origins (use the real frontend domains in prod).
ALLOWED_ORIGINS=*
# Regex for additionally allowed origins. Defaults to localhost/127.0.0.1 on any
# port so local frontend dev always works — no need to set this in prod.
# ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Onboarding
ONBOARDING_MAX_QUESTIONS=5
ONBOARDING_EARLY_STOP_CONFIDENCE=0.8
ONBOARDING_K=0.1
ONBOARDING_SIGMA_STEP=0.12

# Recommendation weights
LAMBDA_CUISINE=0.2
LAMBDA_POP=0.2
MMR_ALPHA=0.7
GPT_CONFIDENCE_DISCOUNT=0.3

# Popularity
DECAY_HALF_LIFE_DAYS=30
